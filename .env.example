# VM 1: Auth Intermediary Service (The AD Proxy)
AUTH_PORT=4000
NODE_ENV=production

# Shared JWT Secret between VM 1 (Auth), VM 2 (Frontend), and VM 3 (Core Backend)
JWT_SHARED_SECRET=distributed-ctf-jwt-secret-shared-across-vms-2026!
JWT_EXPIRY=8h

# Microsoft Active Directory (LDAP) Settings
# Point this to your real Active Directory Domain Controller IP
DEV_MOCK_AUTH=true
LDAP_URL=ldap://192.168.1.100:389
LDAP_BIND_DN=cn=svc_ctf,ou=ServiceAccounts,dc=corp,dc=local
LDAP_BIND_PASSWORD=LdapServicePassword123!
LDAP_BASE_DN=dc=corp,dc=local
LDAP_ADMIN_GROUP_DN=cn=CTF_Admins,ou=Groups,dc=corp,dc=local
LDAP_USER_GROUP_DN=cn=CTF_Users,ou=Groups,dc=corp,dc=local

